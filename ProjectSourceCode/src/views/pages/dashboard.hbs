{{> header}}

<h1 style="text-align: center; font-family: Arial, sans-serif; font-size: 36px; margin-top: 40px;">Welcome to Naxos!</h1>
<p style="text-align: center; font-family: Arial, sans-serif; color: #555;">Your digital wardrobe and outfit planner.</p>


<section style="display: flex; flex-wrap: wrap; gap: 20px; max-width: 900px; margin: 32px auto; padding: 0 16px; font-family: Arial, sans-serif;">
    <article style="flex: 1; min-width: 220px; padding: 24px; background-color: #d9d9d9; border-radius: 8px; text-align: center;">
        <h2>Top Outfits</h2>
        {{#if outfits_image_url}}
            <img src="{{image_url}}" alt="{{name}}">
        {{else}}
            <p>No image available for {{name}}</p>
        {{/if}}
            </article>
    <article style="flex: 1; min-width: 220px; padding: 24px; background-color: #d9d9d9; border-radius: 8px; text-align: center;">
        <h2>Top Clothing Items</h2>
        {{#if clothing_image_url}}
            <img src="{{image_url}}" alt="{{name}}">
        {{else}}
            <p>No image available for {{name}}</p>
        {{/if}}
    </article>
</section>

<button onclick="window.location.href='/outfit'">
    Add Outfit
</button>

<button onclick="window.location.href='/clothing'">
    Add Clothing Item
</button>

{{> footer}}

<main class="container py-4">
    {{> message}}

    {{#if outfit}}
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h1 class="display-5 mb-1">{{outfit.name}}</h1>
                {{#if outfit.description}}<p class="text-muted mb-1">{{outfit.description}}</p>{{/if}}
                {{#if outfit.weather}}<p class="small mb-0">Weather: {{outfit.weather}}</p>{{/if}}
                {{#if outfit.occasion}}<p class="small mb-0">Occasion: {{outfit.occasion}}</p>{{/if}}
            </div>
            <div class="d-flex gap-2">
                <a href="/outfits/{{outfit.outfit_id}}/edit" class="btn btn-primary">Edit</a>
                <form action="/outfits/{{outfit.outfit_id}}/delete" method="POST" class="m-0" onsubmit="return confirm('Delete this outfit? This cannot be undone.');">
                    <button type="submit" class="btn btn-outline-danger">Delete</button>
                </form>
            </div>
        </div>

        {{#if clothing.length}}
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                {{#each clothing}}
                    <div class="col">
                        <article class="card h-100 bg-light">
                            {{#if has_image}}
                                <img src="/inventory/{{item_id}}/image" class="card-img-top object-fit-cover" style="aspect-ratio: 1;" alt="{{name}}" loading="lazy">
                            {{else}}
                                <div class="card-img-top bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center" style="aspect-ratio: 1;">No image</div>
                            {{/if}}
                            <div class="card-body text-center">
                                <h2 class="card-title h6">{{name}}</h2>
                                <p class="small text-muted text-capitalize mb-0">{{category}}</p>
                            </div>
                        </article>
                    </div>
                {{/each}}
            </div>
        {{else}}
            <p class="text-muted">This outfit doesn't have any clothing items yet.</p>
        {{/if}}
        <a href="/outfits" class="btn btn-outline-secondary mt-4">Back to Saved Outfits</a>
    {{/if}}
</main>
